<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 楼层拖拽条的拖动反馈 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    

    <application
        android:name=".S1App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.S1Client"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <!-- 桌面入口 alias（点3 图标切换）：LAUNCHER 移到 alias，切换=启用其一禁其余。
             默认 alias 指向原 ic_launcher；变体 alias 指向 layer-list 色边变体。
             自制 PNG 到位后替换对应 alias 的 android:icon 即可。 -->
        <activity-alias
            android:name=".MainAliasDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainAliasBlue"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_variant_blue"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainAliasGreen"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_variant_green"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainAliasPurple"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_variant_purple"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity android:name=".ThreadDetailActivity"
            android:exported="false" android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".LoginActivity"
            android:exported="false" android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity android:name=".MineActivity"
            android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".FriendListActivity"
            android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".UserThreadListActivity"
            android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".UserReplyListActivity"
            android:exported="false" android:screenOrientation="portrait" />
            <activity
            android:name=".FavoriteListActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".PostBookmarkListActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ReadHistoryActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".DraftListActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <!-- 小黑屋（论坛公开处罚列表），基准实现见开源 s1er -->
        <activity
            android:name=".DarkRoomActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
            <activity
            android:name=".SearchActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
            <activity
            android:name=".PostEditorActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
            <activity
            android:name=".ImageViewerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.S1Client.Fullscreen" />
            <activity android:name=".PmListActivity"
            android:exported="false" />
        <activity android:name=".PmDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".NoticeCenterActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <!-- 设置中心（对标 s1er settings_screen）：主题/震动/字号/字体/小尾巴/版块屏蔽/数据管理 -->
        <activity android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name="com.example.s1client.feature_changelog.ChangelogActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity android:name="com.example.s1client.feature_network.NetworkParamsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity android:name="com.example.s1client.feature_privacy.PrivacyActivity" android:exported="false" android:screenOrientation="portrait" />
</application>
</manifest>
