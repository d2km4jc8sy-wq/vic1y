<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/s1BgPage">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶栏：返回 + 楼主头像/昵称（小红书式）+ 只看楼主 + 收藏 + 分享 -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_glass_topbar"
            android:elevation="2dp"
            android:paddingStart="3dp"
            android:paddingEnd="3dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_back"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <FrameLayout
                android:id="@+id/topAvatarArea"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="2dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <TextView
                    android:id="@+id/tvTopAvatarLetter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivTopAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:alpha="0"
                    app:shapeAppearanceOverlay="@style/CircleImage" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvTopAuthor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxWidth="110dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/s1TextBody"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvThreadTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textSize="13sp"
                android:textColor="?attr/s1TextBody" />

            <TextView
                android:id="@+id/btnOnlyAuthor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:background="@drawable/bg_pill_tonal"
                android:text="只看楼主"
                android:textSize="12sp"
                android:textColor="?attr/s1TextBody"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/btnFavorite"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_star_outline"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <ImageView
                android:id="@+id/btnShare"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_share"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- 本帖屏蔽提示条：本帖屏蔽某人后浮现，点击可管理/恢复 -->
        <TextView
            android:id="@+id/tvMuteBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/s1BgCard"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="13dp"
            android:paddingTop="8dp"
            android:paddingEnd="13dp"
            android:paddingBottom="8dp"
            android:textColor="?attr/s1TextSecondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 投票卡槽：只有 special==1 的投票帖才会往里塞 ComposeView -->
        <!-- 投票卡槽：高度必须有上限。原来 wrap_content，投票卡的 ComposeView
             内容一高就把下面 weight=1 的 ViewPager2 挤成 0 —— 表现为
             「只显示楼主、无法投票」。上限 300dp + 内部滚动。 -->
        <FrameLayout
            android:id="@+id/pollSlot"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/vpPages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never" />

            <com.example.s1client.ui.OrbitDotsView
                android:id="@+id/progressBar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- 底部栏：说点什么… + 页码（点页码可跳页） -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_glass_bottombar"
        android:elevation="8dp"
        android:paddingStart="13dp"
        android:paddingEnd="13dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/btnReplyInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_tonal"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="说点什么…"
            android:textSize="13sp"
            android:textColor="?attr/s1TextSecondary"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvPageInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_btn_pill"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="1 / 1"
            android:textSize="13sp"
            android:textColor="?attr/s1TextSecondary"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- 多选分享底栏：进入多选模式时显示，隐藏原回复条（取消 / 已选计数 / 分享） -->
    <LinearLayout
        android:id="@+id/shareSelectBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_glass_bottombar"
        android:elevation="8dp"
        android:paddingStart="13dp"
        android:paddingEnd="13dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnShareCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_tonal"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="取消"
            android:textSize="13sp"
            android:textColor="?attr/s1TextBody"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvShareCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="已选 0 / 10"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?attr/s1TextBody" />

        <TextView
            android:id="@+id/btnShareSelected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_accent"
            android:paddingStart="21dp"
            android:paddingEnd="21dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="分享"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?attr/s1TextOnAccent"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- 列表到底提示：低调小字，无胶囊背景、无震动，末页滚到底才显示 -->
    <TextView
        android:id="@+id/tvEndFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="14dp"
        android:paddingStart="13dp"
        android:paddingEnd="13dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:text="已经到底了"
        android:textSize="12sp"
        android:textColor="?attr/s1TextSecondary"
        android:visibility="gone" />

    <!-- 贴边页码浮条（左侧中部）：紧凑滚轮 + 进度填充 + 咔哒声，顶部确认块提交，
         2.5s 无操作自动淡出。组件化实现，首页瀑布流可复用同一套 -->
    <com.example.s1client.ui.EdgePageBar
        android:id="@+id/edgePageBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="10dp"
        android:alpha="0"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
