<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginTop="8dp">

    <!-- 卡片内容（原 LinearLayout，间距/内边距下沉到此，根仅作卡片底 + 选中描边/徽标容器） -->
    <LinearLayout
        android:id="@+id/cardContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="13dp"
        android:paddingEnd="13dp"
        android:paddingTop="13dp"
        android:paddingBottom="13dp">

        <!-- 标题：仅楼主层 -->
        <TextView
            android:id="@+id/tvPostTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:textSize="19sp"
            android:textColor="?attr/s1TextTitle"
            android:textStyle="bold"
            android:lineSpacingExtra="3dp"
            android:visibility="gone" />

        <!-- 楼主 meta 行：楼主徽章 + 发帖时间（仅楼主层，替代隐藏的作者行） -->
        <LinearLayout
            android:id="@+id/llOpMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvOpBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_op"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="楼主"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="?attr/s1TextOnAccent" />

            <TextView
                android:id="@+id/tvOpTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="11sp"
                android:textColor="?attr/s1TextTertiary" />
        </LinearLayout>

        <!-- 作者行：头像 + 昵称 + 战斗力 + 楼号（楼号推到最右）。楼主层的作者信息已上移到顶栏，这里整行隐藏 -->
        <LinearLayout
            android:id="@+id/llAuthorRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:id="@+id/avatarClickArea"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <TextView
                    android:id="@+id/tvPostAvatarLetter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivPostAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:alpha="0"
                    app:shapeAppearanceOverlay="@style/CircleImage" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvPostAuthor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="14sp"
                android:textColor="?attr/s1TextBody" />

            <!-- 战斗力：金色小 pill（楼层 JSON 无此字段，由网页版 HTML 解析回填） -->
            <TextView
                android:id="@+id/tvPower"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tag_power"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#C77A00"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvPostFloor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tag_floor"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:textSize="10sp"
                android:textColor="?attr/s1TagText" />
        </LinearLayout>

        <!-- 楼主层置顶大图（有图才显示，像小红书一样放最上面） -->
        <LinearLayout
            android:id="@+id/llTopImages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- 引用卡片（独立卡片，从正文剔除引用段后渲染；点击跳转到被引楼层） -->
        <LinearLayout
            android:id="@+id/llQuote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:background="@drawable/bg_quote_card"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvQuoteAuthor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="?attr/s1TextSecondary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvQuoteBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13.5sp"
                android:textColor="?attr/s1TextTertiary"
                android:lineSpacingExtra="2dp"
                android:maxLines="3"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- 正文（链接自动识别为强调色可点击）-->
        <TextView
            android:id="@+id/tvPostMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="15sp"
            android:textColor="?attr/s1TextBody"
            android:lineSpacingExtra="3dp" />

        <!-- 展开全文（长文超过阈值折叠后显示） -->
        <TextView
            android:id="@+id/tvExpand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#F9486C"
            android:visibility="gone" />

        <!-- 普通楼层图片 -->
        <LinearLayout
            android:id="@+id/llImages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- 评分行：单独占一行（有评分才显示），点击看逐条明细 -->
        <LinearLayout
            android:id="@+id/llRating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/s1BgCardLight"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="评分"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?attr/s1TextSecondary" />

            <TextView
                android:id="@+id/tvRatingInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textSize="12sp"
                android:textColor="?attr/s1TextSecondary" />
        </LinearLayout>

        <!-- 元信息 + 操作行：时间在左，引用/评分/收藏/⋯ 图标在右（40dp 触控区） -->
        <LinearLayout
            android:id="@+id/llActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvPostTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="?attr/s1TextTertiary" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnQuote"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:visibility="gone"
                android:src="@drawable/ic_reply"
                android:contentDescription="引用"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <ImageView
                android:id="@+id/btnRate"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="2dp"
                android:padding="8dp"
                android:visibility="gone"
                android:src="@drawable/ic_rate"
                android:contentDescription="评分"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <ImageView
                android:id="@+id/btnFavoritePost"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="2dp"
                android:padding="8dp"
                android:visibility="gone"
                android:src="@drawable/ic_star"
                android:contentDescription="收藏"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <ImageView
                android:id="@+id/btnMore"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="2dp"
                android:padding="8dp"
                android:src="@drawable/ic_more"
                android:contentDescription="更多"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>
    </LinearLayout>

    <!-- 多选分享：右上角勾选徽标（默认隐藏，进入多选模式后显示） -->
    <ImageView
        android:id="@+id/ivSelectBadge"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_select_badge"
        android:visibility="gone"
        android:src="@drawable/ic_circle_outline" />
</FrameLayout>
