<?xml version="1.0" encoding="utf-8"?>
<!--
  PS1 皮肤版楼层卡片（v3.1：票据 × 手柄融合最终确定版）。

  主楼 = PS1 机身（品牌行 STAGE1 + 板块 → 深色显示屏 → 操作带：评分 chip + 四钮带标签）；
  回复楼 = 右侧锯齿手柄便签（作者行：昵称 + 战斗力 + 头像 + 倾斜评分 stamp → 打孔线 →
  内容 → 底部：时间 + 纯图标四小钮）。

  合入注意：
  - 根结构仍是 FrameLayout#root > 卡片容器#cardContent；
  - cardContent 由 LinearLayout 换成自定义 PsNoteCardView（本身是竖直 LinearLayout，
    负责画右侧锯齿），旧代码里对 cardContent 的引用无需改类型；
  - 保留的旧 id：tvPostTitle/llAuthorRow/llTopImages/llQuote/tvPostMessage/
    tvExpand/llImages/llRating/llActions/btnQuote/btnRate/btnFavoritePost/btnMore/
    ivSelectBadge/avatarClickArea/ivPostAvatar/tvPostAvatarLetter/tvPostAuthor/
    tvPower/llOpMeta/tvOpBadge/tvOpTime/tvQuoteAuthor/tvQuoteBody/tvPostTime/tvRatingInfo；
  - 新增 id：llBrandRow/tvBrandStage1/tvSectionTag/btnNoteStamp/tvNoteScore/
    btnScoreChip/tvChipScore/llNoteButtons/btnNoteFav/btnNoteQuote/btnNoteRate/btnNoteMore；
  - v3.1 移除：llGamepadDecor（便签顶四钮）/llOpUser（主楼底头像昵称）/tvSony/
    llNoteActions（便签底三胶囊）/tvPostFloor（楼层号并入底部时间文本）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginTop="8dp">

    <com.example.s1client.ui.widget.PsNoteCardView
        android:id="@+id/cardContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="13dp"
        android:paddingEnd="13dp"
        android:paddingTop="13dp"
        android:paddingBottom="13dp">

        <!-- ===== 主楼品牌行：STAGE1（左）+ 板块标签（右，纯文字无边框）；回复楼 GONE ===== -->
        <LinearLayout
            android:id="@+id/llBrandRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvBrandStage1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STAGE1"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="?attr/s1Accent"
                android:letterSpacing="0.15"
                android:fontFamily="monospace" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvSectionTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="?attr/s1TextTertiary"
                android:letterSpacing="0.1"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ===== 作者行（回复楼用；主楼整行 GONE，楼主信息在顶栏与机身屏幕内各一份） ===== -->
        <LinearLayout
            android:id="@+id/llAuthorRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvPostAuthor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="?attr/s1TextBody" />

            <!-- 战斗力：金色小 pill -->
            <TextView
                android:id="@+id/tvPower"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tag_power"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#C77A00"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- 便签右上角头像（30dp 圆，细节轮2 对齐顶栏尺寸，点击 → 资料卡） -->
            <FrameLayout
                android:id="@+id/avatarClickArea"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <TextView
                    android:id="@+id/tvPostAvatarLetter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivPostAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:alpha="0"
                    app:shapeAppearanceOverlay="@style/CircleImage" />
            </FrameLayout>

            <!-- 便签右上角倾斜评分 stamp（40dp 虚线方章 rotate(-6deg)，点击 → 查看更多评分） -->
            <FrameLayout
                android:id="@+id/btnNoteStamp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="9dp"
                android:rotation="-6"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvNoteStampLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="评分"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textColor="?attr/s1TextTertiary" />

                    <TextView
                        android:id="@+id/tvNoteScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textColor="?attr/s1TextSecondary"
                        android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- ===== 屏幕区：主楼是深色/暖白"显示屏"，回复楼透明（内容直接落在便签上） ===== -->
        <LinearLayout
            android:id="@+id/llScreenBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <!-- 标题：仅主楼（屏幕内，等宽字体复刻 PS1 标题感） -->
            <TextView
                android:id="@+id/tvPostTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:textSize="16sp"
                android:textColor="?attr/s1TextTitle"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp"
                android:visibility="gone" />

            <!-- 楼主 meta：楼主徽章 + 发帖时间（仅主楼） -->
            <LinearLayout
                android:id="@+id/llOpMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvOpBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_op"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="楼主"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="?attr/s1TextOnAccent" />

                <TextView
                    android:id="@+id/tvOpTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="11sp"
                    android:textColor="?attr/s1TextTertiary" />
            </LinearLayout>

            <!-- 楼主层置顶大图（两列画廊由代码动态生成） -->
            <LinearLayout
                android:id="@+id/llTopImages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- 引用卡片 -->
            <LinearLayout
                android:id="@+id/llQuote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:background="@drawable/bg_quote_card"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvQuoteAuthor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="?attr/s1TextSecondary"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvQuoteBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13.5sp"
                    android:textColor="?attr/s1TextTertiary"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="3"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- 正文 -->
            <TextView
                android:id="@+id/tvPostMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="14.5sp"
                android:textColor="?attr/s1TextBody"
                android:lineSpacingExtra="3dp" />

            <!-- 展开全文 -->
            <TextView
                android:id="@+id/tvExpand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#F9486C"
                android:visibility="gone" />

            <!-- 普通楼层图片 -->
            <LinearLayout
                android:id="@+id/llImages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- 评分汇总行（有评分才显示），点击看逐条明细 -->
            <LinearLayout
                android:id="@+id/llRating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/s1BgCardLight"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="评分"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/s1TextSecondary" />

                <TextView
                    android:id="@+id/tvRatingInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:textSize="12sp"
                    android:textColor="?attr/s1TextSecondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 底部操作行（v3.1 与主楼同构）：
             主楼 = 左评分 chip + 右四钮带标签；回复楼 = 左时间（楼层 · 日期）+ 右纯图标四小钮 ===== -->
        <LinearLayout
            android:id="@+id/llActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 主楼评分 chip（46dp 虚线方章，点击 → 查看更多评分） -->
            <FrameLayout
                android:id="@+id/btnScoreChip"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="评分"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textColor="?attr/s1TextTertiary" />

                    <TextView
                        android:id="@+id/tvChipScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textColor="?attr/s1TextSecondary" />
                </LinearLayout>
            </FrameLayout>

            <!-- 回复楼回帖时间（楼层 · 日期，由代码拼接） -->
            <TextView
                android:id="@+id/tvPostTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="?attr/s1TextTertiary" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- 手柄四钮容器：仅主楼显示（34dp 钮 + 11sp 功能标签，教学面；2026-10-17 点单 9sp→11sp，把手总宽 175sp 恒定） -->
            <LinearLayout
                android:id="@+id/llPsButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <!-- △ 收藏 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginEnd="13dp">

                    <ImageView
                        android:id="@+id/btnFavoritePost"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:padding="7dp"
                        android:background="@drawable/ps_btn_circle"
                        android:src="@drawable/ic_ps_triangle"
                        android:tint="?attr/s1TextTertiary"
                        android:contentDescription="收藏楼层"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="收藏"
                        android:textSize="11sp"
                        android:textColor="?attr/s1TextTertiary" />
                </LinearLayout>

                <!-- ○ 回复 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginEnd="13dp">

                    <ImageView
                        android:id="@+id/btnQuote"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:padding="7dp"
                        android:background="@drawable/ps_btn_circle"
                        android:src="@drawable/ic_ps_circle"
                        android:tint="?attr/s1TextTertiary"
                        android:contentDescription="回复"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="回复"
                        android:textSize="11sp"
                        android:textColor="?attr/s1TextTertiary" />
                </LinearLayout>

                <!-- ✕ 评分 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginEnd="13dp">

                    <ImageView
                        android:id="@+id/btnRate"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:padding="7dp"
                        android:background="@drawable/ps_btn_circle"
                        android:src="@drawable/ic_ps_cross"
                        android:tint="?attr/s1TextTertiary"
                        android:contentDescription="评分"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="评分"
                        android:textSize="11sp"
                        android:textColor="?attr/s1TextTertiary" />
                </LinearLayout>

                <!-- □ 更多 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:id="@+id/btnMore"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:padding="7dp"
                        android:background="@drawable/ps_btn_circle"
                        android:src="@drawable/ic_ps_square"
                        android:tint="?attr/s1TextTertiary"
                        android:contentDescription="更多"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="更多"
                        android:textSize="11sp"
                        android:textColor="?attr/s1TextTertiary" />
                </LinearLayout>
            </LinearLayout>

            <!-- 便签纯图标四小钮容器：仅回复楼显示（22dp 迷你钮，高效面无标签） -->
            <LinearLayout
                android:id="@+id/llNoteButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/btnNoteFav"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="8dp"
                    android:padding="5dp"
                    android:background="@drawable/ps_btn_circle"
                    android:src="@drawable/ic_ps_triangle"
                        android:tint="?attr/s1TextTertiary"
                    android:contentDescription="收藏楼层"
                    android:clickable="true"
                    android:focusable="true" />

                <ImageView
                    android:id="@+id/btnNoteQuote"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="8dp"
                    android:padding="5dp"
                    android:background="@drawable/ps_btn_circle"
                    android:src="@drawable/ic_ps_circle"
                        android:tint="?attr/s1TextTertiary"
                    android:contentDescription="回复"
                    android:clickable="true"
                    android:focusable="true" />

                <ImageView
                    android:id="@+id/btnNoteRate"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="8dp"
                    android:padding="5dp"
                    android:background="@drawable/ps_btn_circle"
                    android:src="@drawable/ic_ps_cross"
                        android:tint="?attr/s1TextTertiary"
                    android:contentDescription="评分"
                    android:clickable="true"
                    android:focusable="true" />

                <ImageView
                    android:id="@+id/btnNoteMore"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:padding="5dp"
                    android:background="@drawable/ps_btn_circle"
                    android:src="@drawable/ic_ps_square"
                        android:tint="?attr/s1TextTertiary"
                    android:contentDescription="更多"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </com.example.s1client.ui.widget.PsNoteCardView>

    <!-- 多选分享：右上角勾选徽标 -->
    <ImageView
        android:id="@+id/ivSelectBadge"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_select_badge"
        android:visibility="gone"
        android:src="@drawable/ic_circle_outline" />
</FrameLayout>
