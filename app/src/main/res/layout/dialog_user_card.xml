<?xml version="1.0" encoding="utf-8"?>
<!-- 透明外层：居中 Dialog，左右留边 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="13dp"
    android:paddingEnd="13dp"
    android:paddingTop="13dp"
    android:paddingBottom="13dp">

    <!-- 悬浮圆角玻璃卡片（外层留 14dp 给 elevation 毛边阴影） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_glass_sheet"
        android:elevation="18dp"
        android:outlineProvider="background"
        android:padding="13dp">

        <!-- 顶栏：关闭按钮右上角 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp">
            <ImageView
                android:id="@+id/tvCardClose"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_close"
                app:tint="?attr/s1TextSecondary"
                android:layout_gravity="end"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:contentDescription="关闭" />
        </FrameLayout>

        <!-- 签名：6 个功能上方，无则隐藏 -->
        <TextView
            android:id="@+id/tvCardSignature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="?attr/s1TextBody"
            android:maxLines="2"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:visibility="gone" />

        <!-- 主区：左列（称号/头像/用户名） + 右列（6 功能 2×3） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 左列 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/tvCardGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="?attr/s1Accent"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:id="@+id/tvCardAvatarLetter"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textSize="32sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:background="@drawable/avatar_fallback_bg" />
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivCardAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:alpha="0"
                        app:shapeAppearanceOverlay="@style/CircleImage" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvCardUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="17sp"
                    android:textColor="?attr/s1TextTitle"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- 右列：上 3 + 下 3，上下对齐 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="18dp"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <!-- 上 3：好友 / 主题 / 回帖 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top">

                    <LinearLayout
                        android:id="@+id/btnCardFriends"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="3dp">
                        <TextView
                            android:id="@+id/tvCardFriends"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textColor="?attr/s1TextTitle"
                            android:textStyle="bold"
                            android:text="--"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textColor="?attr/s1TextSecondary"
                            android:text="好友"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnCardThreads"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="3dp">
                        <TextView
                            android:id="@+id/tvCardThreads"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textColor="?attr/s1TextTitle"
                            android:textStyle="bold"
                            android:text="--"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textColor="?attr/s1TextSecondary"
                            android:text="主题"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnCardPosts"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="3dp">
                        <TextView
                            android:id="@+id/tvCardPosts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textColor="?attr/s1TextTitle"
                            android:textStyle="bold"
                            android:text="--"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textColor="?attr/s1TextSecondary"
                            android:text="回帖"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- 下 3：私信 / 加好友 / 塞抹布 -->
                <LinearLayout
                    android:id="@+id/llCardActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/btnCardPm"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="3dp">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_mail"
                            app:tint="?attr/s1Accent"
                            android:contentDescription="发私信"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textSize="11sp"
                            android:textColor="?attr/s1Accent"
                            android:text="发私信"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnCardFriend"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="3dp">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_account_circle"
                            app:tint="?attr/s1Accent"
                            android:contentDescription="加好友"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textSize="11sp"
                            android:textColor="?attr/s1Accent"
                            android:text="加好友"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnCardBlock"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="3dp">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_block"
                            app:tint="?attr/s1Accent"
                            android:contentDescription="塞抹布"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textSize="11sp"
                            android:textColor="?attr/s1Accent"
                            android:text="塞抹布"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp"
            android:background="?attr/s1Divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="积分"
                android:textSize="13sp"
                android:textColor="?attr/s1TextSecondary" />
            <TextView
                android:id="@+id/tvCardCredits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="?attr/s1TextBody" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="注册时间"
                android:textSize="13sp"
                android:textColor="?attr/s1TextSecondary" />
            <TextView
                android:id="@+id/tvCardRegDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="?attr/s1TextBody" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="战斗力"
                android:textSize="13sp"
                android:textColor="?attr/s1TextSecondary" />
            <TextView
                android:id="@+id/tvCardPower"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="?attr/s1TextBody" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="在线时长"
                android:textSize="13sp"
                android:textColor="?attr/s1TextSecondary" />
            <TextView
                android:id="@+id/tvCardOltime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="?attr/s1TextBody" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="最后访问"
                android:textSize="13sp"
                android:textColor="?attr/s1TextSecondary" />
            <TextView
                android:id="@+id/tvCardLastVisit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="?attr/s1TextBody" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="最后发表"
                android:textSize="13sp"
                android:textColor="?attr/s1TextSecondary" />
            <TextView
                android:id="@+id/tvCardLastPost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="?attr/s1TextBody" />
        </LinearLayout>

        <!-- 积分明细（动态填充，有数据才显示） -->
        <LinearLayout
            android:id="@+id/llCardCreditItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

    </LinearLayout>
</LinearLayout>
