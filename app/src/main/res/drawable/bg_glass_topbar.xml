<?xml version="1.0" encoding="utf-8"?>
<!-- 玻璃顶栏：半透明底 + 底部 1dp 亮线 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/s1GlassBarBg" />
        </shape>
    </item>
    <item
        android:gravity="bottom"
        android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/s1GlassBarLine" />
        </shape>
    </item>
</layer-list>
