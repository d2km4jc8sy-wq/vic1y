<?xml version="1.0" encoding="utf-8"?>
<!-- 实底药丸：玻璃栏上的按钮用（顶栏「只看楼主」、底栏「说点什么」/页码），
     实底 + 主题描边，比透明描边款对比度高一档。
     2026-10-19：底色从 s1BgCardLight 改为 s1BgCard —— s1BgCardLight 同时是楼层卡片的
     操作条底色，机器猫要把它做成红的（详情页红蓝结构），结果底部输入框整条跟着发红。
     药丸改用 s1BgCard（卡片主色），输入框/只看楼主/页码就不会被楼层条的红色牵连。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/s1BgCard" />
            <stroke android:width="1dp" android:color="?attr/s1BorderCard" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/s1BgCard" />
            <stroke android:width="1dp" android:color="?attr/s1BorderCard" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
