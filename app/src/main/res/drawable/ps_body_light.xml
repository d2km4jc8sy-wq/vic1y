<?xml version="1.0" encoding="utf-8"?>
<!-- PS1 主楼机身（浅色页面主题用）：银灰机身要从米白页面里"浮"起来，
     整体比深色皮肤版略压暗一档，描边加重以保证轮廓。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="#E7E5E1"
        android:centerColor="#CFCBC5"
        android:endColor="#B8B5AF"
        android:type="linear" />
    <stroke android:width="1dp" android:color="#A6A39C" />
    <corners android:radius="12dp" />
</shape>
