<?xml version="1.0" encoding="utf-8"?>
<!--
  回复楼手柄便签底（浅色系 · 焙茶/樱雾/苔绿共用）：票据磨砂纸，88% 半透明透出底色。

  细节轮 2（2026-10-16）说明：drawable 的 solid 不支持 "半透明 + ?attr" 组合，
  因此便签纸拆成「每主题一张固定色 drawable + Ps1Skin.noteRes() 选图」，
  每张都取自该主题的 s1BgCardLight（票据纸基色）再压 alpha E0（约 88%）：
  焙茶 #FFFBF0、樱雾 #FFF8FA、苔绿 #E0DCC8、幻彩浅 #F6EDF4。
  上一轮写成写死米黄导致幻彩泛黄（硬编码色不随主题走），本次拆图修正。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E0FFFBF0" />
    <stroke android:width="1dp" android:color="#CFC8B8" />
    <corners android:radius="2dp" />
</shape>