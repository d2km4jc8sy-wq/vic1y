<?xml version="1.0" encoding="utf-8"?>
<!-- 主楼机身上的手柄圆形按键：径向渐变模拟凸起，描边给高光边缘 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="80%"
        android:startColor="#565656"
        android:endColor="#333333" />
    <stroke android:width="1dp" android:color="#5E5E5E" />
</shape>
