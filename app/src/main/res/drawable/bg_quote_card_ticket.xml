<?xml version="1.0" encoding="utf-8"?>
<!--
  引用卡 · 票面版（细节轮3）：便签改为 TicketPalette 深票纸后，
  原浅色内衬（?attr/s1QuoteBg）在深票上是一块突兀的浅米色斑。
  改为票面语汇：半透明深底（透出票纸）+ 亮白细边 + 左侧亮白压边。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#59000000" />
            <corners android:radius="3dp" />
            <stroke android:width="1dp" android:color="#4DFFFFFF" />
        </shape>
    </item>
    <item android:gravity="start|fill_vertical" android:width="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#99FFFFFF" />
        </shape>
    </item>
</layer-list>
